{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SteamSPA rule database",
  "type": "object",
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "meta": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "enabled",
          "risk",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confirm": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "recurse": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
